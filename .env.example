# Copy to .env.local and adjust. Every value here is optional.

# Paths to the binaries, if they are not on PATH
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# Minutes to keep a job's frames and PDF before they are deleted
JOBS_TTL_MINUTES=60

# Most frames a single job may produce. Every frame goes into the PDF, which
# is built in memory, so keep this modest on small servers.
MAX_FRAMES=300

# Jobs processed at the same time, and how many may wait in line
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=20

# New jobs allowed per client IP in each window
RATE_LIMIT_JOBS=5
RATE_LIMIT_WINDOW_MINUTES=5

# Raise if yt-dlp metadata for a video is larger than this many characters
YTDLP_METADATA_MAX_CHARS=5000000
